<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward /api/match and /api/events directly to /api/sync.php for OBS Studio real-time sync
  RewriteRule ^api/match(.*)$ /api/sync.php [L,QSA]
  RewriteRule ^api/events(.*)$ /api/sync.php [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
