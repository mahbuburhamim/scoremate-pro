<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API internals (config, library, schema flags) are never served directly
  RewriteRule ^api/(_|\.) - [F,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<FilesMatch "^(_|\.)">
  Require all denied
</FilesMatch>
